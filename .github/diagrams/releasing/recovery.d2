direction: down

classes: {
  question: {
    shape: diamond
  }
  step: {
    style.border-radius: 8
  }
}

failure: Where did it stop? {
  class: question
}
ci: "Inspect CI or the guard\nfor the candidate SHA" {
  class: step
}
new_commit: Need a new commit? {
  class: question
}
retry: "Fix the cause and rerun\nfailed jobs on the original run" {
  class: step
}
tag: Version tagged? {
  class: question
}
keep: "Fix on sandbox\nKeep the version if still eligible" {
  class: step
}
bump: "Fix on sandbox\nBump as the last commit" {
  class: step
}
qualify: "Push the candidate and wait for sandbox CI OK\nFast-forward develop to that SHA and push\nWait for develop CI OK and run just release" {
  class: step
}
verify: "Verify Release success,\ntag SHA, and develop CI" {
  class: step
}
push: "Fast-forward main\nto the released SHA" {
  class: step
}

failure -> ci: CI or guard
failure -> new_commit: Release job
failure -> verify: Release succeeded
new_commit -> retry: No
new_commit -> tag: Yes
tag -> keep: Untagged
tag -> bump: Tagged
keep -> qualify
bump -> qualify
verify -> push
