#!/usr/bin/env bash
# Release flow: promote the exact commit that passed CI.
#
# Flow overview (`scripts/release deploy <patch|minor|major|current>`)
#   1. Preflight, before anything changes: a clean DEVELOP_BRANCH equal to its
#      origin copy, MAIN_BRANCH able to fast-forward to it, a free tag for the
#      version being released, an authenticated gh, and a working signing setup
#      (a throwaway local tag exercises the key or agent for real).
#   2. Bump: change nothing but the version (RELEASE_FILES), run the local
#      verification as a fast fail, commit "bump version to X.Y.Z" and push it.
#   3. Gate: wait for the push-triggered run of CI_WORKFLOW for exactly that commit.
#      After a failure it keeps waiting RELEASE_RERUN_WAIT seconds, so "Re-run
#      failed jobs" in GitHub lets the release continue on its own.
#   4. Promote: sign the tag on that commit and push it to MAIN_BRANCH together with
#      the tag in one atomic, fast-forward-only push. MAIN_BRANCH, the tag and the
#      tested commit are always the same; no merge happens after testing.
#   5. Optionally keep SYNC_BRANCH (for example a personal work branch) in step.
#
# The flow is safe to rerun: an untagged current version means an earlier run
# stopped after its bump (CI red, network or SSH dropped, Ctrl-C), so every deploy
# finishes that version instead of bumping again, and a bump commit whose push
# failed is pushed first. Server-side, `scripts/release protect` makes GitHub refuse
# any push to MAIN_BRANCH whose commit has not passed REQUIRED_CHECK, admins
# included, and the release workflow's guard refuses to publish a tag that is not
# on MAIN_BRANCH with a green CI run.
#
# Usage: scripts/release deploy <patch|minor|major|current>
#        scripts/release bump <patch|minor|major>
#        scripts/release preflight <patch|minor|major|current>
#        scripts/release protect
# Tuning: RELEASE_POLL_SECONDS (30), RELEASE_CI_TIMEOUT (3600),
#         RELEASE_RERUN_WAIT (900), all in seconds.
set -euo pipefail

# --- Project configuration: the only part to adapt when copying this script ---
DEVELOP_BRANCH="develop"
MAIN_BRANCH="main"
SYNC_BRANCH=""                   # e.g. "sandbox"; empty disables the sync step
CI_WORKFLOW="build.yml"          # workflow that runs on every branch push
REQUIRED_CHECK="CI OK"           # aggregate job in CI_WORKFLOW that branch protection requires
RELEASE_FILES=(Cargo.toml Cargo.lock)

current_version() {
    cargo metadata --no-deps --format-version 1 | jq -r '.packages[0].version'
}

# Change the version in RELEASE_FILES only; dependency updates are separate commits.
apply_bump() {
    cargo set-version --bump "$1"
    cargo update --workspace
}

# Local fast fail before the bump is pushed; CI on that commit is the real gate.
verify_locally() {
    cargo clean
    just full-test
}
# --- End of project configuration ---

POLL_SECONDS="${RELEASE_POLL_SECONDS:-30}"
CI_TIMEOUT="${RELEASE_CI_TIMEOUT:-3600}"
RERUN_WAIT="${RELEASE_RERUN_WAIT:-900}"

die() {
    echo "❌ $*" >&2
    exit 1
}

bump_is_valid() {
    local previous=$1 kind=$2 current=$3 pm pn pp nm nn np
    IFS=. read -r pm pn pp <<<"${previous}"
    IFS=. read -r nm nn np <<<"${current}"
    case "${kind}" in
        patch) ((nm == pm && nn == pn && np == pp + 1)) ;;
        minor) ((nm == pm && nn == pn + 1 && np == 0)) ;;
        major) ((nm == pm + 1 && nn == 0 && np == 0)) ;;
        *) return 1 ;;
    esac
}

next_version() {
    local kind=$1 major minor patch
    IFS=. read -r major minor patch <<<"$(current_version)"
    case "${kind}" in
        patch) echo "${major}.${minor}.$((patch + 1))" ;;
        minor) echo "${major}.$((minor + 1)).0" ;;
        major) echo "$((major + 1)).0.0" ;;
        current) current_version ;;
        *) die "Unknown release kind '${kind}' (patch, minor, major or current)." ;;
    esac
}

tag_exists() {
    git rev-parse -q --verify "refs/tags/$1" >/dev/null 2>&1
}

# Canonical numbers only (no leading zeros, at most six digits): the gate uses them in
# bash arithmetic, where a leading zero would mean octal.
check_seconds() {
    local name=$1 value=$2 min=$3
    if [[ ! "${value}" =~ ^(0|[1-9][0-9]{0,5})$ ]] || ((value < min)); then
        die "${name} must be a whole number of seconds from ${min} to 999999, without leading zeros (got '${value}')."
    fi
}

# Everything a release needs, checked before anything is changed or pushed. With
# mode "unpushed-bump", deploy() has recognized a committed-but-unpushed bump and
# checks everything else before pushing it; only then may HEAD be one commit ahead.
preflight() {
    local kind=$1 mode=${2:-} version probe
    version="$(next_version "${kind}")"
    [[ "$(git branch --show-current)" == "${DEVELOP_BRANCH}" ]] ||
        die "Not on ${DEVELOP_BRANCH} (currently on: $(git branch --show-current))."
    [[ -z "$(git status --porcelain)" ]] || die "Working directory is not clean; commit or stash first."
    for tool in cargo jq gh git; do
        command -v "${tool}" >/dev/null 2>&1 || die "${tool} is required."
    done
    if [[ "${kind}" != "current" ]] && ! cargo set-version -h >/dev/null 2>&1; then
        die "cargo set-version not found; install cargo-edit (cargo install cargo-edit)."
    fi
    check_seconds RELEASE_POLL_SECONDS "${POLL_SECONDS}" 5
    check_seconds RELEASE_CI_TIMEOUT "${CI_TIMEOUT}" 60
    check_seconds RELEASE_RERUN_WAIT "${RERUN_WAIT}" 0

    git fetch --quiet --tags origin
    if [[ "${mode}" != "unpushed-bump" && "$(git rev-parse HEAD)" != "$(git rev-parse "origin/${DEVELOP_BRANCH}")" ]]; then
        die "${DEVELOP_BRANCH} differs from origin/${DEVELOP_BRANCH}; pull or push it first."
    fi
    git merge-base --is-ancestor "origin/${MAIN_BRANCH}" HEAD ||
        die "origin/${MAIN_BRANCH} has commits ${DEVELOP_BRANCH} lacks, so it cannot fast-forward; merge it into ${DEVELOP_BRANCH} first."
    gh auth status >/dev/null 2>&1 || die "gh must be authenticated to follow CI (gh auth login)."
    ! tag_exists "${version}" || die "Tag ${version} already exists."
    probe="release-signing-probe-$$"
    git tag -s "${probe}" -m "signing probe" HEAD >/dev/null 2>&1 ||
        die "git could not sign a tag; check the signing key or agent."
    git tag -d "${probe}" >/dev/null
    if [[ -n "${SSH_CONNECTION:-}" && -z "${HERDR_ENV:-}" && -z "${TMUX:-}" ]]; then
        echo "⚠️  On SSH outside Herdr/tmux: a dropped connection stops this release midway."
        echo "   It is safe to rerun it afterwards; running it inside a multiplexer avoids that."
    fi
    echo "✅ Release preflight passed for ${version}"
}

# Keep SYNC_BRANCH equal to DEVELOP_BRANCH: fast-forward it, or move it with
# --force-with-lease (old tip kept as refs/backup/<branch>/<tip>) when its content
# was squash-merged; leave a branch that is ahead or holds unmerged work alone.
# Never fails the release.
sync_branch() {
    [[ -n "${SYNC_BRANCH}" ]] || return 0
    local target old local_tip
    target="$(git rev-parse HEAD)"
    if ! git fetch --quiet origin "${SYNC_BRANCH}" 2>/dev/null; then
        echo "ℹ️  origin has no ${SYNC_BRANCH} branch; nothing to sync."
        return 0
    fi
    old="$(git rev-parse "refs/remotes/origin/${SYNC_BRANCH}")"
    if [[ "${old}" == "${target}" ]]; then
        echo "✅ ${SYNC_BRANCH} matches ${DEVELOP_BRANCH} (${target:0:12})"
    elif git merge-base --is-ancestor "${target}" "${old}"; then
        echo "ℹ️  ${SYNC_BRANCH} is ahead of ${DEVELOP_BRANCH}; left as is."
        return 0
    elif git merge-base --is-ancestor "${old}" "${target}"; then
        git push --quiet origin "${target}:refs/heads/${SYNC_BRANCH}" ||
            { echo "⚠️  Could not fast-forward ${SYNC_BRANCH}; sync it yourself." >&2; return 0; }
        echo "✅ ${SYNC_BRANCH} fast-forwarded to ${DEVELOP_BRANCH} (${target:0:12})"
    elif git diff --quiet "${old}" "${target}" ||
        { git rev-parse -q --verify "${target}^" >/dev/null && git diff --quiet "${old}" "${target}^"; }; then
        git update-ref "refs/backup/${SYNC_BRANCH}/${old:0:12}" "${old}"
        git push --quiet --force-with-lease="${SYNC_BRANCH}:${old}" origin "${target}:refs/heads/${SYNC_BRANCH}" ||
            { echo "⚠️  ${SYNC_BRANCH} changed on origin meanwhile; left it alone." >&2; return 0; }
        echo "✅ ${SYNC_BRANCH} moved to ${DEVELOP_BRANCH}; old tip kept as refs/backup/${SYNC_BRANCH}/${old:0:12}"
    else
        echo "⚠️  ${SYNC_BRANCH} has changes ${DEVELOP_BRANCH} does not contain; left it alone." >&2
        return 0
    fi
    if git show-ref --verify --quiet "refs/heads/${SYNC_BRANCH}" && [[ "$(git branch --show-current)" != "${SYNC_BRANCH}" ]]; then
        local_tip="$(git rev-parse "refs/heads/${SYNC_BRANCH}")"
        if [[ "${local_tip}" == "${old}" ]] || git merge-base --is-ancestor "${local_tip}" "${target}"; then
            git branch -f "${SYNC_BRANCH}" "${target}" >/dev/null 2>&1 ||
                echo "⚠️  Could not move the local ${SYNC_BRANCH} branch (checked out in another worktree?)." >&2
        fi
    fi
    return 0
}

# Bump the version on DEVELOP_BRANCH and push a commit that changes only RELEASE_FILES.
bump() {
    local kind=$1 previous new status
    [[ "$(git branch --show-current)" == "${DEVELOP_BRANCH}" ]] || die "Not on ${DEVELOP_BRANCH}."
    [[ -z "$(git status --porcelain)" ]] || die "Working directory is not clean; commit or stash first."
    previous="$(current_version)"
    echo "ℹ️  Current version: ${previous}"
    trap 'status=$?; if ((status != 0)); then echo "↩️  Restoring version files after failure..."; git checkout HEAD -- "${RELEASE_FILES[@]}" >/dev/null 2>&1 || true; fi' EXIT
    echo "🔧 Bumping ${kind} version..."
    apply_bump "${kind}"
    new="$(current_version)"
    echo "📝 New version: ${new}"
    bump_is_valid "${previous}" "${kind}" "${new}" || die "Expected a ${kind} bump from ${previous}, got ${new}."
    git fetch --quiet --tags origin
    ! tag_exists "${new}" || die "Tag ${new} already exists."
    echo "🧪 Verifying locally before pushing..."
    verify_locally
    git add -- "${RELEASE_FILES[@]}"
    [[ -z "$(git status --porcelain --untracked-files=no | grep -v '^M  ' || true)" ]] ||
        die "The bump changed files outside RELEASE_FILES; refusing to commit them."
    git commit -m "bump version to ${new}"
    git push origin "${DEVELOP_BRANCH}"
    trap - EXIT
    echo "✅ Version bumped and pushed to ${DEVELOP_BRANCH}"
    sync_branch
}

# Wait for the push-triggered CI_WORKFLOW run of exactly this commit; succeed only if
# it passes (or a re-run of its failed jobs passes within RERUN_WAIT).
gate() {
    local sha=$1 deadline appear_deadline run_id="" listed offline=0 url state status conclusion attempt
    local failed_at="" last="" window
    deadline=$((SECONDS + CI_TIMEOUT))
    appear_deadline=$((SECONDS + 300))
    if ((RERUN_WAIT >= 60)); then window="$((RERUN_WAIT / 60)) minutes"; else window="${RERUN_WAIT} seconds"; fi

    echo "⏳ Waiting for the ${CI_WORKFLOW} run of ${sha:0:12}..."
    while [[ -z "${run_id}" ]]; do
        if listed="$(gh run list --workflow "${CI_WORKFLOW}" --commit "${sha}" --event push --limit 1 \
            --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null)"; then
            offline=0
            run_id="${listed}"
            if [[ -z "${run_id}" ]] && ((SECONDS >= appear_deadline)); then
                die "No ${CI_WORKFLOW} run appeared for ${sha} within 5 minutes."
            fi
        else
            ((offline)) || echo "⚠️  GitHub unreachable; still waiting (retrying every 10s)..."
            offline=1
            appear_deadline=$((SECONDS + 300))
            ((SECONDS < deadline)) || die "GitHub stayed unreachable; rerun the deploy when back online."
        fi
        [[ -n "${run_id}" ]] || sleep 10
    done
    url="$(gh run view "${run_id}" --json url --jq .url 2>/dev/null || echo "run ${run_id}")"
    echo "🔗 ${url}"

    while true; do
        state="$(gh run view "${run_id}" --json status,conclusion,attempt \
            --jq '"\(.status) \(.conclusion // "-") \(.attempt)"' 2>/dev/null || echo "unknown - ?")"
        read -r status conclusion attempt <<<"${state}"
        if [[ "${status}" == "unknown" ]]; then
            [[ "${last}" == "unknown" ]] || echo "⚠️  GitHub unreachable; still waiting (retrying every ${POLL_SECONDS}s)..."
            last="unknown"
            ((SECONDS < deadline)) || die "GitHub stayed unreachable; rerun the deploy when back online."
            sleep "${POLL_SECONDS}"
            continue
        fi
        if [[ "${status} ${attempt}" != "${last}" ]]; then
            echo "   CI: ${status} (attempt ${attempt})"
            last="${status} ${attempt}"
        fi
        if [[ "${status}" == "completed" ]]; then
            if [[ "${conclusion}" == "success" ]]; then
                echo "✅ CI passed for ${sha:0:12}"
                return 0
            fi
            if [[ -z "${failed_at}" ]]; then
                failed_at="${SECONDS}"
                echo "❌ CI finished with '${conclusion}': ${url}" >&2
                echo "   Re-run the failed jobs in GitHub within ${window} and this release" >&2
                echo "   continues by itself; Ctrl-C to stop waiting." >&2
            elif ((SECONDS - failed_at >= RERUN_WAIT)); then
                echo "❌ No re-run started within ${window}; nothing was released." >&2
                die "Re-run the jobs or fix forward on ${DEVELOP_BRANCH}, then run the deploy again."
            fi
        elif [[ -n "${failed_at}" ]]; then
            echo "🔁 Re-run started; following attempt ${attempt}"
            failed_at=""
            deadline=$((SECONDS + CI_TIMEOUT))
        fi
        if [[ -z "${failed_at}" ]] && ((SECONDS >= deadline)); then
            die "CI did not finish within ${CI_TIMEOUT}s (${url}); when it passes, run the deploy again."
        fi
        sleep "${POLL_SECONDS}"
    done
}

# Tag the CI-verified commit and move MAIN_BRANCH to it in one atomic push.
promote() {
    local version=$1 sha=$2
    echo "🏷️  Creating signed tag ${version} on ${sha:0:12}..."
    git tag -s "${version}" "${sha}" -m "Release version ${version}"
    echo "⬆️  Pushing ${sha:0:12} to ${MAIN_BRANCH} together with tag ${version} (atomic)..."
    if ! git push --atomic origin "${sha}:refs/heads/${MAIN_BRANCH}" "refs/tags/${version}"; then
        git tag -d "${version}" >/dev/null 2>&1 || true
        die "Push rejected; nothing was released and the local tag was removed."
    fi
    git fetch --quiet origin
    if git show-ref --verify --quiet "refs/heads/${MAIN_BRANCH}" && [[ "$(git branch --show-current)" != "${MAIN_BRANCH}" ]]; then
        if git merge-base --is-ancestor "${MAIN_BRANCH}" "origin/${MAIN_BRANCH}"; then
            git branch -f "${MAIN_BRANCH}" "origin/${MAIN_BRANCH}" >/dev/null
        else
            echo "⚠️  Local ${MAIN_BRANCH} has commits origin/${MAIN_BRANCH} lacks; left it untouched." >&2
        fi
    fi
    echo "✅ Released ${version}: ${MAIN_BRANCH} and the tag point at ${sha:0:12}"
}

deploy() {
    local kind=$1 current version sha
    git fetch --quiet --tags origin
    current="$(current_version)"

    # A bump committed but never pushed (its push failed): after the full preflight,
    # which then tolerates exactly this commit, push it.
    if [[ "$(git branch --show-current)" == "${DEVELOP_BRANCH}" ]] && ! tag_exists "${current}" &&
        [[ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/${DEVELOP_BRANCH}")" ]] &&
        [[ "$(git rev-parse -q --verify HEAD^ || true)" == "$(git rev-parse "origin/${DEVELOP_BRANCH}")" ]] &&
        [[ "$(git log -1 --format=%s HEAD)" == "bump version to ${current}" ]] &&
        [[ -z "$(git diff --name-only HEAD^ HEAD | grep -vxF -f <(printf '%s\n' "${RELEASE_FILES[@]}") || true)" ]]; then
        echo "ℹ️  The bump to ${current} was committed but never pushed; checking, then pushing it."
        preflight current unpushed-bump
        git push origin "${DEVELOP_BRANCH}"
        sync_branch
    fi

    # An untagged current version: an earlier run stopped after its bump.
    if [[ "${kind}" != "current" ]] && ! tag_exists "${current}"; then
        echo "ℹ️  ${current} is bumped but not released yet; finishing that release (no new bump)."
        [[ "${kind}" == "patch" ]] || echo "   Run the ${kind} deploy again afterwards for the ${kind} bump."
        kind="current"
    fi

    preflight "${kind}"
    [[ "${kind}" == "current" ]] || bump "${kind}"
    version="$(current_version)"
    sha="$(git rev-parse HEAD)"
    gate "${sha}"
    promote "${version}" "${sha}"
    sync_branch
    echo "🎉 Version ${version} released"
    echo "🔗 Monitor the release: https://github.com/$(gh repo view --json nameWithOwner -q .nameWithOwner)/actions"
}

# Apply branch protection: MAIN_BRANCH only accepts commits whose REQUIRED_CHECK
# passed (admins included), with signed commits and linear history. Every field is
# set explicitly: GitHub keeps an omitted one (an old "lock branch" would then block
# every release push once admins are enforced). DEVELOP_BRANCH
# keeps signed, linear history but no required checks, since it receives untested
# merges by design and MAIN_BRANCH is the gate. No pull requests are required.
protect() {
    local repo
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
    gh api -X PUT "repos/${repo}/branches/${MAIN_BRANCH}/protection" --input - >/dev/null <<EOF
{
  "required_status_checks": {"strict": false, "checks": [{"context": "${REQUIRED_CHECK}", "app_id": 15368}]},
  "enforce_admins": true,
  "required_pull_request_reviews": null,
  "restrictions": null,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": false,
  "lock_branch": false,
  "allow_fork_syncing": false
}
EOF
    gh api -X PUT "repos/${repo}/branches/${DEVELOP_BRANCH}/protection" --input - >/dev/null <<EOF
{
  "required_status_checks": null,
  "enforce_admins": false,
  "required_pull_request_reviews": null,
  "restrictions": null,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": false,
  "lock_branch": false,
  "allow_fork_syncing": false
}
EOF
    for branch in "${MAIN_BRANCH}" "${DEVELOP_BRANCH}"; do
        gh api -X POST "repos/${repo}/branches/${branch}/protection/required_signatures" >/dev/null
    done
    echo "✅ ${MAIN_BRANCH} requires '${REQUIRED_CHECK}' (admins included); ${DEVELOP_BRANCH} and ${MAIN_BRANCH} require signed, linear history."
}

case "${1:-}" in
    deploy) deploy "${2:-patch}" ;;
    bump) bump "${2:-patch}" ;;
    preflight) preflight "${2:-patch}" ;;
    protect) protect ;;
    *)
        sed -n '/^# Usage:/,/^# Tuning:/p' "$0" | sed 's/^# \{0,1\}//' >&2
        exit 2
        ;;
esac
